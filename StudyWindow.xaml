<Window x:Class="NoteApp.StudyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Study Hub" Height="720" Width="900"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="CanResize" MinWidth="700" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16" Margin="12,12,12,0" CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1a1d28" Offset="0"/>
                    <GradientStop Color="#1e2235" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Study Hub" FontSize="18" FontWeight="Bold" Foreground="#d8dae2"/>
                    <TextBlock x:Name="lblStudyInfo" FontSize="11" Foreground="#7d8298" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="+ เพิ่มวิชา" Click="AddSubject_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="16,8" FontSize="12" FontWeight="SemiBold"
                        Background="#7b93f7" Foreground="White"/>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Margin="12,8,12,12" Background="#13151c"
                    BorderBrush="#272b38" Foreground="#d8dae2">
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="AI ช่วยเรียน" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelAIStudy" Margin="14"/>
                </ScrollViewer>
            </TabItem>
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="การบ้าน / งาน" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelAssignments" Margin="14"/>
                </ScrollViewer>
            </TabItem>
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="เกรด / GPA" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelGrades" Margin="14"/>
                </ScrollViewer>
            </TabItem>
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="ตารางเรียน" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelSchedule" Margin="14"/>
                </ScrollViewer>
            </TabItem>
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="Focus Timer" VerticalAlignment="Center"/>
                </TabItem.Header>
                <StackPanel x:Name="panelPomodoro" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
