<Window x:Class="NoteApp.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ถังขยะ" Height="500" Width="480"
        WindowStartupLocation="CenterOwner" Background="#0f1018"
        ResizeMode="CanResize" MinWidth="350" MinHeight="300">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="ถังขยะ" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                <TextBlock x:Name="lblTrashInfo" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="panelTrash"/>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#161828" Padding="14,10">
            <Button Content="ปิด" HorizontalAlignment="Right" Click="Close_Click"
                    Padding="16,7" FontSize="12" FontWeight="SemiBold"
                    Background="#2a2d45" Foreground="#8b8fa7" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>
    </Grid>
</Window>
