<Window x:Class="NoteApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Height="500" Width="380" ResizeMode="NoResize"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Drag_MouseDown">

    <Border CornerRadius="18" Padding="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f1018" Offset="0"/>
                <GradientStop Color="#161828" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2a2d45" Offset="0"/>
                <GradientStop Color="#3a3d60" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1.5</Border.BorderThickness>

        <Grid>
            <!-- Close button -->
            <Button Content="✕" Click="CloseBtn_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,14,16,0" Padding="6,2" FontSize="13"
                    Background="Transparent" Foreground="#3a3d55" BorderThickness="0" Cursor="Hand"/>

            <StackPanel VerticalAlignment="Center" Margin="36,10,36,20">
                <!-- Logo -->
                <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center"
                        Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6c63ff" Offset="0"/>
                            <GradientStop Color="#8b7aff" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="N" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Note App" FontSize="22" FontWeight="Bold" Foreground="#e8e9f0"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="เข้าสู่ระบบเพื่อเริ่มต้นใช้งาน" FontSize="11"
                           Foreground="#5a5d78" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <!-- Tab: Login / Signup -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="tabLogin" Content="เข้าสู่ระบบ" Click="TabLogin_Click"
                            Grid.Column="0" Padding="0,10" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#6c63ff" CornerRadius="8,0,0,8" Padding="0,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="tabSignup" Content="สมัครใหม่" Click="TabSignup_Click"
                            Grid.Column="1" Padding="0,10" FontSize="13" FontWeight="SemiBold"
                            Foreground="#5a5d78" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#1c1e30" CornerRadius="0,8,8,0" Padding="0,10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Message -->
                <TextBlock x:Name="lblMessage" Text="" FontSize="12"
                           Foreground="#e5484d" HorizontalAlignment="Center" Margin="0,0,0,8"
                           TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Username -->
                <TextBlock Text="ชื่อผู้ใช้" Foreground="#5a5d78" FontSize="11" Margin="0,0,0,5"
                           FontWeight="Medium"/>
                <Border Background="#1a1c2c" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <TextBox x:Name="txtUsername" FontSize="14" Padding="0"
                             Background="Transparent" Foreground="#e0e2eb" BorderThickness="0"
                             CaretBrush="#6c63ff"/>
                </Border>

                <!-- Password -->
                <TextBlock Text="รหัสผ่าน" Foreground="#5a5d78" FontSize="11" Margin="0,0,0,5"
                           FontWeight="Medium"/>
                <Border Background="#1a1c2c" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <PasswordBox x:Name="txtPassword" FontSize="14" Padding="0"
                                 Background="Transparent" Foreground="#e0e2eb" BorderThickness="0"
                                 CaretBrush="#6c63ff"/>
                </Border>

                <!-- Confirm Password (signup only) -->
                <StackPanel x:Name="panelConfirm" Visibility="Collapsed">
                    <TextBlock Text="ยืนยันรหัสผ่าน" Foreground="#5a5d78" FontSize="11" Margin="0,0,0,5"
                               FontWeight="Medium"/>
                    <Border Background="#1a1c2c" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <PasswordBox x:Name="txtConfirm" FontSize="14" Padding="0"
                                     Background="Transparent" Foreground="#e0e2eb" BorderThickness="0"
                                     CaretBrush="#6c63ff"/>
                    </Border>
                </StackPanel>

                <!-- Main button -->
                <Button x:Name="btnAction" Content="เข้าสู่ระบบ" Click="Action_Click" Margin="0,4,0,0"
                        Padding="0,12" FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                        Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Padding="0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#6c63ff" Offset="0"/>
                                        <GradientStop Color="#8070ff" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Skip -->
                <Button Content="ข้ามขั้นตอนนี้" Click="Skip_Click" Margin="0,12,0,0"
                        Padding="8,4" FontSize="11"
                        Background="Transparent" Foreground="#3a3d55" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Center"/>

                <TextBlock Text="v2.0 · ข้อมูลเก็บในเครื่องเท่านั้น" FontSize="9"
                           Foreground="#252840" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
