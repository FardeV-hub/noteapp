<Window x:Class="NoteApp.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="สรุปและวิเคราะห์โน้ต" Height="680" Width="640"
        WindowStartupLocation="CenterOwner" Background="#0f1018"
        ResizeMode="CanResize" MinWidth="500" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="สรุปและวิเคราะห์" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                <TextBlock x:Name="lblSubtitle" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" x:Name="tabMain" Margin="8" Background="#0f1018"
                    BorderBrush="#2a2d45" Foreground="#e8e9f0">
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="สรุป AI" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0f1018">
                    <StackPanel x:Name="panelAI" Margin="12"/>
                </ScrollViewer>
            </TabItem>

            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="ตามความสำคัญ" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0f1018">
                    <StackPanel x:Name="panelPriority" Margin="12"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#161828" Padding="14,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Export สรุป" Click="ExportSummary_Click"
                        Padding="16,8" FontSize="12" FontWeight="SemiBold"
                        Background="#2980b9" Foreground="White"/>
                <Button Content="ปิด" Click="Close_Click" Margin="8,0,0,0"
                        Padding="16,8" FontSize="12"
                        Background="#2a2d45" Foreground="#8b8fa7"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
