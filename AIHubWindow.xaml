<Window x:Class="NoteApp.AIHubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Hub" Height="720" Width="870"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="CanResize" MinWidth="650" MinHeight="450">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Gradient Banner -->
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="12" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8b5cf6" Offset="0"/>
                                <GradientStop Color="#6c63ff" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🤖" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AI Hub" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                        <TextBlock x:Name="lblProvider" FontSize="11" Foreground="#5a5d78"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#ffffff15" CornerRadius="8" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ AI:" FontSize="12" Foreground="#b4a0ff" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="cmbProvider" Width="170" FontSize="12" Padding="4" SelectionChanged="Provider_Changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Buttons: Segmented Control -->
        <Border Grid.Row="1" Background="#13151c" Padding="16,8,16,4">
            <Border Background="#161628" CornerRadius="12" Padding="4">
                <StackPanel x:Name="panelTabBtns" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </Border>
        </Border>

        <!-- Content Pages -->
        <Grid Grid.Row="2" Margin="16,4,16,12">
            <!-- Chat Page -->
            <Grid x:Name="pageChat">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="14" Padding="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0d0d1a" Offset="0"/>
                            <GradientStop Color="#111125" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelChat" Margin="6"/>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="1" CornerRadius="14" Padding="10" Margin="0,8,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#161628" Offset="0"/>
                            <GradientStop Color="#1a1a35" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtChat" FontSize="13" Padding="12" AcceptsReturn="True" Height="55"
                                 TextWrapping="Wrap" Background="#1e1e38" Foreground="#e8e9f0"
                                 BorderBrush="#2a2a50" BorderThickness="1" KeyDown="Chat_KeyDown">
                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style></TextBox.Resources>
                        </TextBox>
                        <Button Grid.Column="1" Click="SendChat_Click" Margin="8,0,0,0" Cursor="Hand" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="12" Width="58">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8b5cf6" Offset="0"/>
                                                <GradientStop Color="#6c63ff" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="↑" FontSize="22" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Tools Page -->
            <ScrollViewer x:Name="pageTools" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="panelTools" Margin="4"/>
            </ScrollViewer>

            <!-- Settings Page -->
            <ScrollViewer x:Name="pageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel Margin="4" MaxWidth="520">
                    <Border Background="#161628" CornerRadius="10" Padding="12,8" Margin="0,0,0,14">
                        <TextBlock Text="🔑  ตั้งค่า API Keys — ใส่ครั้งเดียว ใช้ได้ตลอด" FontSize="14" FontWeight="SemiBold" Foreground="#b4a0ff"/>
                    </Border>

                    <Border Background="#12121f" CornerRadius="12" Padding="18" Margin="0,0,0,10" BorderBrush="#8b5cf620" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#8b5cf622" Margin="0,0,10,0">
                                    <TextBlock Text="🟣" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Claude (Anthropic)" FontSize="14" FontWeight="Bold" Foreground="#8b5cf6"/>
                                    <TextBlock Text="console.anthropic.com" FontSize="10" Foreground="#5a5d78"/></StackPanel>
                            </StackPanel>
                            <TextBox x:Name="txtClaudeKey" FontSize="12" Padding="10" Margin="0,10,0,0" Background="#1a1a30" Foreground="#e8e9f0" BorderBrush="#2a2a50" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources></TextBox>
                        </StackPanel>
                    </Border>

                    <Border Background="#12121f" CornerRadius="12" Padding="18" Margin="0,0,0,10" BorderBrush="#22c55e20" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#22c55e22" Margin="0,0,10,0">
                                    <TextBlock Text="🟢" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OpenAI (GPT)" FontSize="14" FontWeight="Bold" Foreground="#22c55e"/>
                                    <TextBlock Text="platform.openai.com" FontSize="10" Foreground="#5a5d78"/></StackPanel>
                            </StackPanel>
                            <TextBox x:Name="txtOpenAIKey" FontSize="12" Padding="10" Margin="0,10,0,0" Background="#1a1a30" Foreground="#e8e9f0" BorderBrush="#2a2a50" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources></TextBox>
                        </StackPanel>
                    </Border>

                    <Border Background="#12121f" CornerRadius="12" Padding="18" Margin="0,0,0,10" BorderBrush="#3b82f620" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#3b82f622" Margin="0,0,10,0">
                                    <TextBlock Text="🔵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Google Gemini" FontSize="14" FontWeight="Bold" Foreground="#3b82f6"/>
                                    <TextBlock Text="aistudio.google.com (ฟรี!)" FontSize="10" Foreground="#5a5d78"/></StackPanel>
                            </StackPanel>
                            <TextBox x:Name="txtGeminiKey" FontSize="12" Padding="10" Margin="0,10,0,0" Background="#1a1a30" Foreground="#e8e9f0" BorderBrush="#2a2a50" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources></TextBox>
                        </StackPanel>
                    </Border>

                    <Border Background="#12121f" CornerRadius="12" Padding="18" Margin="0,0,0,10" BorderBrush="#eab30820" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#eab30822" Margin="0,0,10,0">
                                    <TextBlock Text="🟡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Hugging Face (ฟรี!)" FontSize="14" FontWeight="Bold" Foreground="#eab308"/>
                                    <TextBlock Text="huggingface.co/settings/tokens" FontSize="10" Foreground="#5a5d78"/></StackPanel>
                            </StackPanel>
                            <TextBox x:Name="txtHFKey" FontSize="12" Padding="10" Margin="0,10,0,0" Background="#1a1a30" Foreground="#e8e9f0" BorderBrush="#2a2a50" BorderThickness="1">
                                <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style></TextBox.Resources></TextBox>
                        </StackPanel>
                    </Border>

                    <Button Click="SaveKeys_Click" Cursor="Hand" BorderThickness="0" Margin="0,6,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="12" Padding="0,12">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#8b5cf6" Offset="0"/>
                                            <GradientStop Color="#6c63ff" Offset="0.5"/>
                                            <GradientStop Color="#8b5cf6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="💾  บันทึก API Keys ทั้งหมด" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
