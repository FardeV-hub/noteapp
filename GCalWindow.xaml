<Window x:Class="NoteApp.GCalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Calendar" Height="620" Width="700"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="CanResize" MinWidth="500" MinHeight="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="6" Margin="0,0,0,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="16,12">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="Google Calendar" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                        <TextBlock x:Name="lblGCalStatus" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Content="🔄 รีเฟรช" Click="Refresh_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="14,7" FontSize="12" Background="#4285f4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Background="#13151c" BorderBrush="#2a2d45" Foreground="#e8e9f0">
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="วันนี้" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelToday" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="สัปดาห์นี้" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelWeek" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="เดือนนี้" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelMonth" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="ตั้งค่า" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel Margin="12" MaxWidth="500">
                        <TextBlock Text="⚙️ ตั้งค่า Google Calendar" FontSize="16" FontWeight="Bold" Foreground="#e8e9f0" Margin="0,0,0,12"/>

                        <Border Background="#161828" CornerRadius="10" Padding="14" BorderBrush="#4285f4" BorderThickness="0,0,0,3">
                            <StackPanel>
                                <TextBlock Text="Google API Key" Foreground="#8b8fa7" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtGCalKey" FontSize="12" Padding="6" Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>
                                <TextBlock Text="วิธีขอ: console.cloud.google.com → APIs → Calendar API → Enable → Credentials → API Key" FontSize="10" Foreground="#5a5d78" Margin="0,4,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="Calendar ID" Foreground="#8b8fa7" FontSize="12" Margin="0,12,0,4"/>
                                <TextBox x:Name="txtCalId" FontSize="12" Padding="6" Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>
                                <TextBlock Text="ใช้ 'primary' สำหรับปฏิทินหลัก หรือใส่ email ของปฏิทินอื่น" FontSize="10" Foreground="#5a5d78" Margin="0,4,0,0"/>

                                <Button Content="💾 บันทึก" Click="SaveGCalConfig_Click" Margin="0,12,0,0"
                                        Padding="16,8" FontSize="13" Background="#4285f4" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#161828" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8b8fa7" LineHeight="22" Text=
"📋 วิธีตั้งค่า Google Calendar API:&#x0a;&#x0a;1. ไปที่ console.cloud.google.com&#x0a;2. สร้าง Project ใหม่ หรือเลือกที่มี&#x0a;3. ไปที่ APIs &amp; Services → Library&#x0a;4. ค้นหา 'Google Calendar API' → Enable&#x0a;5. ไปที่ Credentials → Create Credentials → API Key&#x0a;6. คัดลอก API Key มาใส่&#x0a;&#x0a;⚠️ ปฏิทินต้องตั้งเป็น Public หรือใช้ OAuth2 สำหรับปฏิทินส่วนตัว"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
