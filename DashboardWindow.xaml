<Window x:Class="NoteApp.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="680" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="600" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#e8e9f0"/>
                <TextBlock Text="สถิติภาพรวมทั้งหมด" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="panelMain" Margin="20"/>
        </ScrollViewer>
    </Grid>
</Window>
