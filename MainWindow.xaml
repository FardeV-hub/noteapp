<Window x:Class="NoteApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Note App" Height="720" Width="1060" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#13151c"
        Closing="Window_Closing" KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#13151c"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#1c1f2a"/>
        <SolidColorBrush x:Key="Surface2Brush" Color="#272b38"/>
        <SolidColorBrush x:Key="TextBrush" Color="#d8dae2"/>
        <SolidColorBrush x:Key="Text2Brush" Color="#7d8298"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#7b93f7"/>

        <!-- Sidebar Nav Button -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#252838" CornerRadius="8"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353a50"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded Action Button -->
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{DynamicResource Surface2Brush}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon Button -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="135"/>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ===== SIDEBAR RAIL ===== -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource Surface2Brush}"
                BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <Border DockPanel.Dock="Top" Height="36" CornerRadius="7"
                        Background="{DynamicResource AccentBrush}" Margin="8,12,8,10">
                    <TextBlock Text="N  Note App" FontSize="13" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Bottom: Theme + Account -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <Button x:Name="btnCloudSync" Click="CloudSync_Click" Style="{StaticResource NavBtn}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Cloud" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Height="1" Background="#303345" Margin="12,5"/>
                    <Button x:Name="btnTheme" Click="Theme_Click" Style="{StaticResource NavBtn}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="ธีม" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button x:Name="btnAccounts" Click="Accounts_Click" Style="{StaticResource NavBtn}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="โปรไฟล์" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nav items -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="btnCalendar" Click="Calendar_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="ปฏิทิน" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnGCal" Click="GCal_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="GCal" VerticalAlignment="Center"/></StackPanel>
                        </Button>

                        <Border Height="1" Background="#303345" Margin="12,6"/>

                        <Button x:Name="btnFinance" Click="Finance_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="การเงิน" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnMeeting" Click="Meeting_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="ประชุม" VerticalAlignment="Center"/></StackPanel>
                        </Button>

                        <Border Height="1" Background="#303345" Margin="12,6"/>

                        <Button x:Name="btnDashboard" Click="Dashboard_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xF246;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnSummary" Click="Summary_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="สรุป" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnStudy" Click="Study_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE736;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="เรียน" VerticalAlignment="Center"/></StackPanel>
                        </Button>

                        <Border Height="1" Background="#303345" Margin="12,6"/>

                        <Button x:Name="btnAIHub" Click="AIHub_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="AI Hub" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnSmartHome" Click="SmartHome_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="บ้าน" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <Button x:Name="btnCommunity" Click="Community_Click" Style="{StaticResource NavBtn}">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Community" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== LIST PANEL ===== -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="16,16,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="โน้ต" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4"
                                Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="lblUser" FontSize="10"
                                       Foreground="{DynamicResource Text2Brush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnGroupToggle" ToolTip="จัดกลุ่ม"
                                Click="GroupToggle_Click" Style="{StaticResource IconBtn}" Margin="0,0,2,0">
                            <TextBlock Text="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button ToolTip="Quick Note (Ctrl+N)"
                                Click="QuickNote_Click" Style="{StaticResource IconBtn}">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Search -->
                <Border Grid.Row="1" Margin="14,12,14,0" Background="{DynamicResource Surface2Brush}"
                        CornerRadius="8" Padding="0">
                    <TextBox x:Name="txtSearch" FontSize="13" Padding="11,9"
                             TextChanged="Search_Changed"
                             Background="Transparent"
                             Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource AccentBrush}"/>
                </Border>

                <!-- Category tabs -->
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="14,10,14,8">
                    <StackPanel x:Name="panelCatTabs" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Note list -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="6,0,6,0">
                    <StackPanel x:Name="panelNotes"/>
                </ScrollViewer>

                <!-- Google Search (compact footer) -->
                <Border Grid.Row="4" BorderBrush="{DynamicResource Surface2Brush}"
                        BorderThickness="0,1,0,0" Padding="10,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBox x:Name="txtGoogleSearch" Width="110" FontSize="11" Padding="6,4"
                                 Background="{DynamicResource Surface2Brush}"
                                 Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="Transparent" BorderThickness="0"
                                 KeyDown="GoogleSearch_KeyDown"
                                 ToolTip="Ctrl+G · พิมพ์แล้วกด Enter"/>
                        <Button x:Name="btnGoogleSearch" Click="GoogleSearch_Click"
                                Style="{StaticResource IconBtn}" Width="26" Height="26" ToolTip="ค้นหา Google">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Click="GoogleMaps_Click" ToolTip="Maps"
                                Style="{StaticResource IconBtn}" Width="26" Height="26">
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Click="GoogleTranslate_Click" ToolTip="แปลภาษา"
                                Style="{StaticResource IconBtn}" Width="26" Height="26">
                            <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Click="YouTube_Click" ToolTip="YouTube"
                                Style="{StaticResource IconBtn}" Width="26" Height="26">
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ===== EDITOR PANEL ===== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Editor Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="0,0,0,1"
                    Padding="14,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Category + Priority -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="cmbCategory" FontSize="12" Padding="6" Width="110"
                                  IsEditable="False" VerticalAlignment="Center"/>
                        <Button Content="+" Click="AddCategory_Click"
                                Style="{StaticResource IconBtn}" Width="26" Height="26"
                                FontSize="15" FontWeight="Bold" ToolTip="เพิ่มหมวดหมู่"/>

                        <Border Width="1" Background="{DynamicResource Surface2Brush}"
                                Margin="8,4" Height="20"/>

                        <ComboBox x:Name="cmbPriority" FontSize="12" Padding="6" Width="120"
                                  IsEditable="False" VerticalAlignment="Center">
                            <ComboBoxItem Content="⚪ ปกติ" Tag="ปกติ" IsSelected="True"/>
                            <ComboBoxItem Content="🟢 ต่ำ" Tag="ต่ำ"/>
                            <ComboBoxItem Content="🟡 ปานกลาง" Tag="ปานกลาง"/>
                            <ComboBoxItem Content="🔴 สูง" Tag="สูง"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Right: Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Pin_Click" ToolTip="ปักหมุด" Style="{StaticResource IconBtn}">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button Click="LockNote_Click" ToolTip="ล็อคโน้ต" Style="{StaticResource IconBtn}">
                            <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                        <Button Click="Delete_Click" ToolTip="ลบโน้ต" Style="{StaticResource IconBtn}">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                        </Button>

                        <Border Width="1" Background="{DynamicResource Surface2Brush}"
                                Margin="6,4" Height="20"/>

                        <Button Content="ล้าง" Click="Clear_Click"
                                Style="{StaticResource GhostBtn}" Margin="0,0,4,0"/>
                        <Button Content="แก้ไข" Click="Edit_Click"
                                Style="{StaticResource RoundBtn}" Background="#e0930a"
                                Padding="12,6" Margin="0,0,4,0"/>
                        <Button Content="บันทึก" Click="Add_Click"
                                Style="{StaticResource RoundBtn}" Background="{DynamicResource AccentBrush}"
                                Padding="14,6" FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Editor Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,18,24,24">
                    <!-- Title input (large, clean) -->
                    <TextBox x:Name="txtTitle" FontSize="20" FontWeight="Bold" Padding="4,8"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             BorderThickness="0"
                             CaretBrush="{DynamicResource AccentBrush}"/>

                    <!-- Content -->
                    <TextBlock Text="เนื้อหา" Foreground="{DynamicResource Text2Brush}"
                               FontSize="11" Margin="4,16,0,6" FontWeight="SemiBold"
                               Opacity="0.6"/>
                    <TextBox x:Name="txtContent" FontSize="14" Padding="16" MinHeight="220"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="1"
                             CaretBrush="{DynamicResource AccentBrush}"/>

                    <!-- Reminder -->
                    <TextBlock Text="แจ้งเตือน" Foreground="{DynamicResource Text2Brush}"
                               FontSize="11" Margin="4,18,0,6" FontWeight="SemiBold"
                               Opacity="0.6"/>
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8">
                        <WrapPanel>
                            <DatePicker x:Name="dpDate" FontSize="12" Width="130"
                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="txtHour" Width="40" FontSize="13" Padding="6"
                                     Background="{DynamicResource Surface2Brush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="Transparent" TextAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text=" : " FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text2Brush}"/>
                            <TextBox x:Name="txtMinute" Width="40" FontSize="13" Padding="6"
                                     Background="{DynamicResource Surface2Brush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="Transparent" TextAlignment="Center"
                                     VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbRemind" FontSize="12" Padding="6"
                                      Margin="8,0,0,0" Width="130" IsEditable="False"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="ไม่แจ้งเตือน" Tag="-1" IsSelected="True"/>
                                <ComboBoxItem Content="ตรงเวลา" Tag="0"/>
                                <ComboBoxItem Content="5 นาทีก่อน" Tag="5"/>
                                <ComboBoxItem Content="15 นาทีก่อน" Tag="15"/>
                                <ComboBoxItem Content="30 นาทีก่อน" Tag="30"/>
                                <ComboBoxItem Content="1 ชั่วโมงก่อน" Tag="60"/>
                            </ComboBox>
                        </WrapPanel>
                    </Border>

                    <!-- Expander: Share / Export -->
                    <Expander Header="แชร์ / Export" Foreground="{DynamicResource Text2Brush}"
                              FontSize="12" Margin="0,22,0,0" IsExpanded="False">
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Export .txt" Click="ExportOne_Click" Style="{StaticResource RoundBtn}" Background="#2980b9" Margin="0,0,4,4"/>
                            <Button Content="Export ทั้งหมด" Click="ExportAll_Click" Style="{StaticResource RoundBtn}" Background="#2c3e50" Margin="0,0,4,4"/>
                            <Button Content="Copy" Click="CopyClipboard_Click" Style="{StaticResource RoundBtn}" Background="#636e72" Margin="0,0,4,4"/>
                            <Button Content="Email" Click="SendEmail_Click" Style="{StaticResource RoundBtn}" Background="#0984e3" Margin="0,0,4,4"/>
                            <Button Content="ปฏิทิน" Click="ExportCalendar_Click" Style="{StaticResource RoundBtn}" Background="#00b894" Margin="0,0,4,4"/>
                            <Button Content="LINE" Click="SendLine_Click" Style="{StaticResource RoundBtn}" Background="#00b900" Margin="0,0,4,4"/>
                            <Button Content="⚙ LINE" Click="SetupLine_Click" Style="{StaticResource RoundBtn}" Background="#555555" Margin="0,0,4,4"/>
                            <Button Content="QR" Click="CreateQR_Click" Style="{StaticResource RoundBtn}" Background="#8e44ad" Margin="0,0,4,4"/>
                            <Button Content="สแกน" Click="ScanQR_Click" Style="{StaticResource RoundBtn}" Background="#6c3483" Margin="0,0,4,4"/>
                            <Button Content="HTML" Click="ShareHTML_Click" Style="{StaticResource RoundBtn}" Background="#e84393" Margin="0,0,4,4"/>
                            <Button Content="Telegram" Click="SendTelegram_Click" Style="{StaticResource RoundBtn}" Background="#0088cc" Margin="0,0,4,4"/>
                            <Button Content="⚙ TG" Click="SetupTelegram_Click" Style="{StaticResource RoundBtn}" Background="#555555" Margin="0,0,4,4"/>
                            <Button Content="เตือนจ่าย" Click="SpendingAlert_Click" Style="{StaticResource RoundBtn}" Background="#e17055" Margin="0,0,4,4"/>
                        </WrapPanel>
                    </Expander>

                    <!-- Expander: AI / Template -->
                    <Expander Header="AI / เทมเพลต" Foreground="{DynamicResource Text2Brush}"
                              FontSize="12" Margin="0,6,0,0" IsExpanded="False">
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="จัดหมวด AI" Click="AIAutoCategory_Click" Style="{StaticResource RoundBtn}" Background="#6c63ff" Margin="0,0,4,4"/>
                            <Button Content="เทมเพลต" Click="Template_Click" Style="{StaticResource RoundBtn}" Background="#00b894" Margin="0,0,4,4"/>
                            <Button Content="Checklist" Click="Checklist_Click" Style="{StaticResource RoundBtn}" Background="#0984e3" Margin="0,0,4,4"/>
                        </WrapPanel>
                    </Expander>

                    <!-- Expander: Backup / Security -->
                    <Expander Header="สำรอง / ความปลอดภัย" Foreground="{DynamicResource Text2Brush}"
                              FontSize="12" Margin="0,6,0,0" IsExpanded="False">
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Import" Click="ImportJson_Click" Style="{StaticResource RoundBtn}" Background="#2980b9" Margin="0,0,4,4"/>
                            <Button Content="Export JSON" Click="ExportJson_Click" Style="{StaticResource RoundBtn}" Background="#2c3e50" Margin="0,0,4,4"/>
                            <Button Content="Backup" Click="Backup_Click" Style="{StaticResource RoundBtn}" Background="#636e72" Margin="0,0,4,4"/>
                            <Button Content="ถังขยะ" Click="TrashBin_Click" Style="{StaticResource RoundBtn}" Background="#7f8c8d" Margin="0,0,4,4"/>
                            <Button Content="PIN" Click="SetPIN_Click" Style="{StaticResource RoundBtn}" Background="#555555" Margin="0,0,4,4"/>
                            <Button Content="Auth" Click="SetAuth_Click" Style="{StaticResource RoundBtn}" Background="#8e44ad" Margin="0,0,4,4"/>
                        </WrapPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource Surface2Brush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#4aba78" Margin="0,0,8,0"
                             VerticalAlignment="Center" Opacity="0.8"/>
                    <TextBlock x:Name="lblStatus" Text="พร้อมใช้งาน"
                               Foreground="{DynamicResource Text2Brush}" FontSize="11"
                               VerticalAlignment="Center" Opacity="0.8"/>
                </StackPanel>
                <TextBlock Text="Ctrl+N ใหม่  ·  Ctrl+F ค้นหา  ·  Ctrl+S บันทึก"
                           Foreground="{DynamicResource Text2Brush}" FontSize="10" Opacity="0.4"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
