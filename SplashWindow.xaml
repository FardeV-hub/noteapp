<Window x:Class="NoteApp.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Height="300" Width="380" ResizeMode="NoResize">
    <Border CornerRadius="18" Padding="0">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0f1018" Offset="0"/>
                <GradientStop Color="#161828" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#2a2d45" Offset="0"/>
                <GradientStop Color="#3a3d60" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1.5</Border.BorderThickness>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo -->
                <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6c63ff" Offset="0"/>
                            <GradientStop Color="#8b7aff" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="N" FontSize="26" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Note App" FontSize="26" FontWeight="Bold" Foreground="#e8e9f0"
                           HorizontalAlignment="Center" Margin="0,0,0,3"/>
                <TextBlock Text="Productivity Suite" FontSize="12" Foreground="#5a5d78"
                           HorizontalAlignment="Center" Margin="0,0,0,28" FontWeight="Medium"/>

                <ProgressBar x:Name="progressBar" Width="180" Height="3" IsIndeterminate="True"
                             Foreground="#6c63ff" Background="#1c1e30" BorderThickness="0"/>
                <TextBlock x:Name="lblLoading" Text="กำลังโหลด..." FontSize="11" Foreground="#5a5d78"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <TextBlock Text="v2.0" FontSize="10" Foreground="#2a2d45"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
        </Grid>
    </Border>
</Window>
