<Window x:Class="NoteApp.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="โปรไฟล์" Height="620" Width="480"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with avatar -->
        <Border Grid.Row="0" Padding="0,0,0,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1d28" Offset="0"/>
                    <GradientStop Color="#252840" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel HorizontalAlignment="Center" Margin="0,28,0,0">
                <!-- Avatar -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Border x:Name="avatarBorder" Width="90" Height="90" CornerRadius="45"
                            Background="#272b38" BorderBrush="#7b93f7" BorderThickness="3">
                        <Border.Clip>
                            <EllipseGeometry Center="45,45" RadiusX="45" RadiusY="45"/>
                        </Border.Clip>
                        <Grid>
                            <TextBlock x:Name="avatarInitial" Text="?" FontSize="36" FontWeight="Bold"
                                       Foreground="#7b93f7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="avatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btnChangeAvatar" Click="ChangeAvatar_Click"
                            Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#7b93f7" Foreground="White" Padding="0" FontSize="14"
                            ToolTip="เปลี่ยนรูปโปรไฟล์">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Display Name -->
                <TextBlock x:Name="lblDisplayName" Text="ชื่อผู้ใช้" FontSize="20" FontWeight="Bold"
                           Foreground="#d8dae2" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblRole" Text="สมาชิก" FontSize="12"
                           Foreground="#7d8298" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,28">

                <TextBlock Text="ชื่อที่แสดง" Foreground="#7d8298" FontSize="11" Margin="0,0,0,5" FontWeight="Medium"/>
                <TextBox x:Name="txtDisplayName" FontSize="14" Padding="12,10"
                         Background="#1c1f2a" Foreground="#d8dae2"
                         BorderBrush="#272b38" BorderThickness="1"/>

                <TextBlock Text="สถานะ / คำอธิบายตัวเอง" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                <TextBox x:Name="txtBio" FontSize="13" Padding="12,10" Height="70"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Background="#1c1f2a" Foreground="#d8dae2"
                         BorderBrush="#272b38" BorderThickness="1"/>

                <TextBlock Text="Email" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                <TextBox x:Name="txtEmail" FontSize="13" Padding="12,10"
                         Background="#1c1f2a" Foreground="#d8dae2"
                         BorderBrush="#272b38" BorderThickness="1"/>

                <TextBlock Text="โรงเรียน / มหาวิทยาลัย" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                <TextBox x:Name="txtSchool" FontSize="13" Padding="12,10"
                         Background="#1c1f2a" Foreground="#d8dae2"
                         BorderBrush="#272b38" BorderThickness="1"/>

                <TextBlock Text="บริษัท / ที่ทำงาน" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                <TextBox x:Name="txtCompany" FontSize="13" Padding="12,10"
                         Background="#1c1f2a" Foreground="#d8dae2"
                         BorderBrush="#272b38" BorderThickness="1"/>

                <TextBlock Text="บทบาท" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                <ComboBox x:Name="cmbRole" FontSize="13" Padding="8">
                    <ComboBoxItem Content="สมาชิก"/>
                    <ComboBoxItem Content="นักเรียน / นักศึกษา"/>
                    <ComboBoxItem Content="พนักงาน"/>
                    <ComboBoxItem Content="ฟรีแลนซ์"/>
                    <ComboBoxItem Content="ผู้จัดการ"/>
                    <ComboBoxItem Content="อาจารย์"/>
                    <ComboBoxItem Content="นักพัฒนา"/>
                </ComboBox>

                <TextBlock x:Name="lblJoined" Foreground="#5a5d70" FontSize="11" Margin="0,16,0,0"/>

                <!-- Save -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="ยกเลิก" Click="Cancel_Click"
                            Padding="18,9" FontSize="13"
                            Background="#272b38" Foreground="#7d8298"/>
                    <Button Content="บันทึก" Click="Save_Click" Margin="8,0,0,0"
                            Padding="18,9" FontSize="13" FontWeight="SemiBold"
                            Background="#7b93f7" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
