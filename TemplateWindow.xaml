<Window x:Class="NoteApp.TemplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เลือกเทมเพลต" Height="460" Width="440"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="20,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="เทมเพลตโน้ต" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                <TextBlock Text="เลือกเทมเพลตเพื่อเริ่มเขียนโน้ตได้เร็วขึ้น" FontSize="11"
                           Foreground="#5a5d78" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12">
            <StackPanel x:Name="panelTemplates"/>
        </ScrollViewer>
    </Grid>
</Window>
