<Window x:Class="NoteApp.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="เชื่อมต่อบัญชี" Height="650" Width="550"
        WindowStartupLocation="CenterOwner" Background="#0f1018"
        ResizeMode="CanResize" MinWidth="450" MinHeight="400">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="6" Margin="0,0,0,8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Margin="16,12">
                <TextBlock Text="Accounts Hub" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                <TextBlock x:Name="lblStatus" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="panelServices" Margin="4"/>
        </ScrollViewer>
    </Grid>
</Window>
