<Window x:Class="NoteApp.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="โปรไฟล์และบัญชี" Height="680" Width="560"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="CanResize" MinWidth="450" MinHeight="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with avatar -->
        <Border Grid.Row="0" Padding="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1a1d28" Offset="0"/>
                    <GradientStop Color="#252840" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                <Grid HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Border x:Name="avatarBorder" Width="80" Height="80" CornerRadius="40"
                            Background="#272b38" BorderBrush="#7b93f7" BorderThickness="3">
                        <Border.Clip>
                            <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                        </Border.Clip>
                        <Grid>
                            <TextBlock x:Name="avatarInitial" Text="?" FontSize="32" FontWeight="Bold"
                                       Foreground="#7b93f7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="avatarImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btnChangeAvatar" Click="ChangeAvatar_Click"
                            Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#7b93f7" Foreground="White" Padding="0"
                            ToolTip="เปลี่ยนรูปโปรไฟล์">
                        <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="lblDisplayName" Text="" FontSize="18" FontWeight="Bold"
                           Foreground="#d8dae2" HorizontalAlignment="Center"/>
                <TextBlock x:Name="lblRole" Text="" FontSize="11"
                           Foreground="#7d8298" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="#13151c" BorderBrush="#272b38" Foreground="#d8dae2">
            <!-- Tab: Profile -->
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="โปรไฟล์" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel Margin="24,18,24,24">
                        <TextBlock Text="ชื่อที่แสดง" Foreground="#7d8298" FontSize="11" Margin="0,0,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="txtDisplayName" FontSize="14" Padding="12,10"
                                 Background="#1c1f2a" Foreground="#d8dae2"
                                 BorderBrush="#272b38" BorderThickness="1"
                                 TextChanged="DisplayName_Changed"/>

                        <TextBlock Text="สถานะ / Bio" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="txtBio" FontSize="13" Padding="12,10" Height="65"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#1c1f2a" Foreground="#d8dae2"
                                 BorderBrush="#272b38" BorderThickness="1"/>

                        <TextBlock Text="Email" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="txtEmail" FontSize="13" Padding="12,10"
                                 Background="#1c1f2a" Foreground="#d8dae2"
                                 BorderBrush="#272b38" BorderThickness="1"/>

                        <TextBlock Text="โรงเรียน / มหาวิทยาลัย" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="txtSchool" FontSize="13" Padding="12,10"
                                 Background="#1c1f2a" Foreground="#d8dae2"
                                 BorderBrush="#272b38" BorderThickness="1"/>

                        <TextBlock Text="บริษัท / ที่ทำงาน" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                        <TextBox x:Name="txtCompany" FontSize="13" Padding="12,10"
                                 Background="#1c1f2a" Foreground="#d8dae2"
                                 BorderBrush="#272b38" BorderThickness="1"/>

                        <TextBlock Text="บทบาท" Foreground="#7d8298" FontSize="11" Margin="0,14,0,5" FontWeight="Medium"/>
                        <ComboBox x:Name="cmbRole" FontSize="13" Padding="8">
                            <ComboBoxItem Content="สมาชิก"/>
                            <ComboBoxItem Content="นักเรียน / นักศึกษา"/>
                            <ComboBoxItem Content="พนักงาน"/>
                            <ComboBoxItem Content="ฟรีแลนซ์"/>
                            <ComboBoxItem Content="ผู้จัดการ"/>
                            <ComboBoxItem Content="อาจารย์"/>
                            <ComboBoxItem Content="นักพัฒนา"/>
                        </ComboBox>

                        <TextBlock x:Name="lblJoined" Foreground="#5a5d70" FontSize="11" Margin="0,14,0,0"/>

                        <Button Content="บันทึกโปรไฟล์" Click="SaveProfile_Click" Margin="0,18,0,0"
                                Padding="20,10" FontSize="13" FontWeight="SemiBold"
                                Background="#7b93f7" Foreground="White" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Accounts -->
            <TabItem FontSize="13" FontWeight="Medium">
                <TabItem.Header>
                    <TextBlock Text="เชื่อมต่อบัญชี" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelServices" Margin="16"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
