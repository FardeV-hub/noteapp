<Window x:Class="NoteApp.MeetingRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ระบบห้องประชุม" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="#13151c"
        ResizeMode="CanResize" MinWidth="700" MinHeight="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,16" Margin="0,0,0,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#161828" Offset="0"/>
                    <GradientStop Color="#1c1e35" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Meeting Hub" FontSize="18" FontWeight="Bold" Foreground="#e8e9f0"/>
                        <TextBlock x:Name="lblInfo" FontSize="11" Foreground="#5a5d78" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="+ เพิ่มห้อง" x:Name="btnAddRoom" Click="AddRoom_Click"
                            Padding="14,7" FontSize="12" FontWeight="SemiBold"
                            Background="#6c63ff" Foreground="White"/>
                    <Button Content="วันนี้" x:Name="btnToday" Click="Today_Click" Margin="8,0,0,0"
                            Padding="14,7" FontSize="12" Background="#2a2d45" Foreground="#e8e9f0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: Tabs -->
        <TabControl Grid.Row="1" Background="#13151c" BorderBrush="#2a2d45" Foreground="#e8e9f0">
            <!-- Tab: ตารางห้องประชุม -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="ตาราง" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelSchedule" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: จองห้องประชุม -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="จองห้อง" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelBooking" Margin="12" MaxWidth="500">
                        <TextBlock Text="จองห้องประชุม" FontSize="16" FontWeight="Bold"
                                   Foreground="#e8e9f0" Margin="0,0,0,14"/>

                        <TextBlock Text="ห้องประชุม" Foreground="#8b8fa7" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbRoom" FontSize="13" Padding="8"/>

                        <TextBlock Text="หัวข้อการประชุม" Foreground="#8b8fa7" FontSize="12" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtTopic" FontSize="13" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <TextBlock Text="วันที่" Foreground="#8b8fa7" FontSize="12" Margin="0,10,0,4"/>
                        <DatePicker x:Name="dpBookDate" FontSize="12" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="เวลา" Foreground="#8b8fa7" FontSize="12" Margin="0,10,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="cmbStartTime" FontSize="13" Padding="6" Width="100"/>
                            <TextBlock Text=" ถึง " Foreground="#e8e9f0" VerticalAlignment="Center" Margin="8,0"/>
                            <ComboBox x:Name="cmbEndTime" FontSize="13" Padding="6" Width="100"/>
                        </StackPanel>

                        <TextBlock Text="ผู้จัด" Foreground="#8b8fa7" FontSize="12" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtOrganizer" FontSize="13" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <TextBlock Text="ผู้เข้าร่วม (คั่นด้วย ,)" Foreground="#8b8fa7" FontSize="12" Margin="0,10,0,4"/>
                        <TextBox x:Name="txtParticipants" FontSize="13" Padding="8" Height="50"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="จองห้อง" Click="BookRoom_Click"
                                    Padding="18,8" FontSize="13" FontWeight="SemiBold"
                                    Background="#27ae60" Foreground="White"/>
                            <Button Content="จอง + สร้างโน้ต" Click="BookAndNote_Click" Margin="8,0,0,0"
                                    Padding="18,8" FontSize="13" FontWeight="SemiBold"
                                    Background="#0984e3" Foreground="White"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="ส่ง Discord" Click="SendDiscord_Click"
                                    Padding="18,8" FontSize="12"
                                    Background="#5865F2" Foreground="White"/>
                            <Button Content="ส่ง Classroom" Click="SendClassroom_Click" Margin="8,0,0,0"
                                    Padding="18,8" FontSize="12"
                                    Background="#0f9d58" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: รายการจอง -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="รายการจอง" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelAllBookings" Margin="8"/>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Discord -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="Discord" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelDiscord" Margin="12" MaxWidth="550">
                        <TextBlock Text="🎮 เชื่อมต่อ Discord" FontSize="16" FontWeight="Bold" Foreground="#e8e9f0" Margin="0,0,0,10"/>

                        <TextBlock Text="Discord Webhook URL" Foreground="#8b8fa7" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtDiscordWebhook" FontSize="12" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"
                                 TextWrapping="Wrap"/>
                        <TextBlock Text="วิธีสร้าง: Server Settings → Integrations → Webhooks → New Webhook → Copy URL"
                                   FontSize="10" Foreground="#5a5d78" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Discord Bot Token (ถ้ามี)" Foreground="#8b8fa7" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox x:Name="txtDiscordBot" FontSize="12" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <TextBlock Text="Channel ID สำหรับแจ้งเตือน" Foreground="#8b8fa7" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox x:Name="txtDiscordChannel" FontSize="12" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="บันทึกการตั้งค่า" Click="SaveDiscord_Click"
                                    Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                    Background="#5865F2" Foreground="White"/>
                            <Button Content="ทดสอบส่ง" Click="TestDiscord_Click" Margin="8,0,0,0"
                                    Padding="16,8" FontSize="12"
                                    Background="#2a2d45" Foreground="#e8e9f0"/>
                        </StackPanel>

                        <Border Background="#161828" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 ฟีเจอร์ Discord" FontSize="14" FontWeight="Bold" Foreground="#5865F2" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8b8fa7" LineHeight="22"
                                           Text="• ส่งแจ้งเตือนการจองห้องประชุมเข้า Discord channel&#x0a;• แจ้งเตือนก่อนประชุมเริ่ม&#x0a;• ส่งสรุปโน้ตการประชุมหลังจบ&#x0a;• แจ้งเตือนเมื่อมีคนจอง/ยกเลิกห้อง"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: Classroom -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="Classroom" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelClassroom" Margin="12" MaxWidth="550">
                        <TextBlock Text="📚 เชื่อมต่อ Google Classroom" FontSize="16" FontWeight="Bold" Foreground="#e8e9f0" Margin="0,0,0,10"/>

                        <TextBlock Text="Google API Key" Foreground="#8b8fa7" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="txtGoogleApiKey" FontSize="12" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>
                        <TextBlock Text="สร้างได้ที่ console.cloud.google.com → APIs → Credentials"
                                   FontSize="10" Foreground="#5a5d78" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Course ID (รหัสวิชา)" Foreground="#8b8fa7" FontSize="12" Margin="0,12,0,4"/>
                        <TextBox x:Name="txtCourseId" FontSize="12" Padding="8"
                                 Background="#2a2d45" Foreground="#e8e9f0" BorderBrush="#2a2d45"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="บันทึกการตั้งค่า" Click="SaveClassroom_Click"
                                    Padding="16,8" FontSize="12" FontWeight="SemiBold"
                                    Background="#0f9d58" Foreground="White"/>
                            <Button Content="ดึงงาน/ประกาศ" Click="FetchClassroom_Click" Margin="8,0,0,0"
                                    Padding="16,8" FontSize="12"
                                    Background="#2a2d45" Foreground="#e8e9f0"/>
                        </StackPanel>

                        <TextBlock Text="📥 รายการที่ดึงมาจาก Classroom" Foreground="#8b8fa7" FontSize="13"
                                   FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <StackPanel x:Name="panelClassroomItems"/>

                        <Border Background="#161828" CornerRadius="10" Padding="14" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="📋 ฟีเจอร์ Classroom" FontSize="14" FontWeight="Bold" Foreground="#0f9d58" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#8b8fa7" LineHeight="22"
                                           Text="• ดึงรายการงาน/ประกาศจาก Google Classroom&#x0a;• สร้างโน้ตจากงานที่มอบหมายอัตโนมัติ&#x0a;• ดึง deadline มาตั้งเป็น Reminder&#x0a;• โพสต์สรุปการประชุมกลับไป Classroom"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab: จัดการห้อง -->
            <TabItem FontSize="13" FontWeight="SemiBold">
                <TabItem.Header>
                    <TextBlock Text="จัดการห้อง" VerticalAlignment="Center"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#13151c">
                    <StackPanel x:Name="panelRooms" Margin="8"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
